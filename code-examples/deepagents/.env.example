# DeepAgents 配置
#
# 步骤：
# 1. 复制此文件为 .env
# 2. 填入你的 LLM 配置
# 3. 运行：python main.py

# ===== LLM 配置 =====
# 支持任何 OpenAI 兼容的服务

# ⭐ DeepSeek（推荐）
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-key-here

# 或其他服务（OpenAI、Azure 等）
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-your-key-here

# 调试模式
LANGCHAIN_DEBUG=false
